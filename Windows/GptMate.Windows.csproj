<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GptMate</AssemblyName>
    <RootNamespace>GptMate.Windows</RootNamespace>
    <ApplicationIcon>Resources\GptMateIcon.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Company>ncy0608</Company>
    <Product>GptMate</Product>
    <Description>Codex quota and task monitor for Windows 11</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\Resources\GptMateIcon.png" Link="Resources\GptMateIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
